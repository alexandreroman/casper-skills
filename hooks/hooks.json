{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh || true",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
