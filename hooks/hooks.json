{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh || true",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh || true",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh || true",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/notification.py || true",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CASPER_WORKSPACE_ID\" ] && ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use-tasks.py || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
